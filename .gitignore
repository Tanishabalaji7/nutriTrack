# Environment secrets
.env
*.env.local

# Compiled Java Bytecode
backend/bin/
*.class

# Keep lib JARs (dependencies needed for build)
!backend/lib/*.jar

# Runtime Logs
*.log
backend/server.log

# SQLite database (runtime data — don't commit)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# Operating System Files
.DS_Store
Thumbs.db

# IDE & Editor files
.idea/
.vscode/
*.iml

# Unused folders
untitled folder/
untitled folder 2/
